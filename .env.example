POSTGRES_DB=tenderpilot
POSTGRES_USER=tenderpilot
POSTGRES_PASSWORD=tenderpilot_dev
POSTGRES_PORT=55432

OPENSEARCH_PORT=19200

DB_URL=jdbc:postgresql://localhost:55432/tenderpilot
DB_USERNAME=tenderpilot
DB_PASSWORD=tenderpilot_dev

OPENSEARCH_URL=http://localhost:19200
OLLAMA_URL=http://localhost:11434

CORS_ALLOWED_ORIGINS=http://localhost:3000

ACCESS_TOKEN_ISSUER=tenderpilot-local
ACCESS_TOKEN_SECRET=tenderpilot-development-access-token-secret-2026-change-before-production
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
REFRESH_COOKIE_NAME=tenderpilot_refresh
REFRESH_COOKIE_SECURE=false

NEXT_PUBLIC_API_URL=http://localhost:8080

# TED Search API v3 — public published-notice API, no API key required
TED_BASE_URL=https://api.ted.europa.eu
TED_SEARCH_PATH=/v3/notices/search
TED_DEFAULT_LOOKBACK_DAYS=7
TED_DEFAULT_LIMIT=25
TED_MAX_LIMIT=100
TED_MANUAL_SYNC_ENABLED=true

# BOAMP / DILA OpenDataSoft Explore API — free public access
BOAMP_BASE_URL=https://boamp-datadila.opendatasoft.com
BOAMP_RECORDS_PATH=/api/explore/v2.1/catalog/datasets/boamp/records
BOAMP_DATASET_ID=boamp
BOAMP_DEFAULT_LOOKBACK_DAYS=7
BOAMP_DEFAULT_LIMIT=25
BOAMP_MAX_LIMIT=100
BOAMP_MANUAL_SYNC_ENABLED=true

# DECP — French awarded public contracts
DECP_BASE_URL=https://data.economie.gouv.fr
DECP_RECORDS_PATH=/api/explore/v2.1/catalog/datasets/decp-2022-marches-valides/records
DECP_DATASET_ID=decp-2022-marches-valides
DECP_DEFAULT_LOOKBACK_DAYS=7
DECP_DEFAULT_LIMIT=25
DECP_MAX_LIMIT=100
DECP_MANUAL_SYNC_ENABLED=true
